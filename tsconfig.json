{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals", "vitest/config"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "alwaysStrict": true,
    "skipLibCheck": true
  },
  "include": [
    "node_modules/vite/client.d.ts",
    "src/client/**/*",
    "apps/palette-generator/**/*"
  ]
}
